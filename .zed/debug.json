    "program": "$ZED_FILE",
    "request": "launch"
  },
  {
    "adapter": "Debugpy",
    "label": "eventvlad",
    "request": "launch",
    "python": "\"$ZED_CUSTOM_PYTHON_ACTIVE_ZED_TOOLCHAIN\"",
